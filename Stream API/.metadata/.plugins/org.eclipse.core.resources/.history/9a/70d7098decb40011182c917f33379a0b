package numbers;

import java.util.Arrays;
import java.util.List;

public class duplicate {

	public static void main(String[] args) {
		List <String> words = Arrays.asList("Aarya", "Aditi", "Rucha", "Sakshi", "Ayush", "Aarya", "Rucha");
		words.stream()
		.filter(n -> !words.add(n))
		.distinct()
		.forEach(System.out :: println);
		

	}

}
