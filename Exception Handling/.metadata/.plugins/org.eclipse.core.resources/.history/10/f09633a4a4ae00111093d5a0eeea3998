package colors;

public class Color {
	private int red;
	private int blue;
	private int green;
	
	public Color(int red, int blue, int green) throws InvalidColorException{
		if (red < 0 || red > 255 || green < 0 || green > 255 || red < 0 || green > 255)
			throw new InvalidColorException("Invalid Argument");
		
		this.red = red;
		this.blue = blue;
		this.green = green;
	}
	
	public void displayColor() {
		System.out.println("Red : " + red);
		System.out.println("Green : " + green);
        System.out.println("Blue : " + blue);
	}
	     
}
