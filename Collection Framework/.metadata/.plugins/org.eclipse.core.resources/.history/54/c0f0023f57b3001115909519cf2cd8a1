package ArrayClass;

import java.util.Arrays;

public class ArrayCalculations {

	public static void main(String[] args) {
		int [] arr = {23,43,53,28,76,56,90,65};
		
		System.out.println("Original Array: " + Arrays.toString(arr));
		
		System.out.println("Filling the Array: "); 
		Arrays.fill(arr, 100);
		System.out.println(Arrays.toString(arr));
		
		arr = new int [] {23,43,53,28,76,56,90,65};
		
		System.out.println("Filling the Array to specific index: "); 
		Arrays.fill(arr,2, 3, 100);
		System.out.println(Arrays.toString(arr));
		
		arr = new int [] {23,43,53,28,76,56,90,65};
		
		System.out.println("Array clone:  "); 
		int [] arr2 = arr.clone();
		System.out.println(Arrays.toString(arr2));
		
		arr = new int [] {23,43,53,28,76,56,90,65};
		System.out.println("Using Equals: ");
		System.out.println(Arrays.equals(arr, arr2));
		
		
		
	}

}
