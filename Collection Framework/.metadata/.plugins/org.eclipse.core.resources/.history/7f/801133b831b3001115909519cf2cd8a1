package array_operations;

public class ArrayOperation <T> {

	public boolean <T> search(T [] arr, T key) {
		boolean flag = false;
		for(T n : arr) {
			if (n.equals(key))
				flag = true;
		}
		return flag;
	}
	
	public static <T> void print(T [] arr) {
		for(T n : arr) {
			System.out.println("Array is: " + n);
		}
	}

	

}
